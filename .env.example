# Vercel AI Gateway (Gemini via google/gemini-2.5-flash-lite)
# Create at: Vercel dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# OpenAI (optional alternative — not wired by default)
# OPENAI_API_KEY=

# Neon Postgres (injected by Vercel Marketplace when connected)
POSTGRES_URL=
# DATABASE_URL=

# Integration mode:
#   0 = name.com sandbox + Postgres-hosted site link + mock SerpApi
#   1 = name.com sandbox + Vercel deploy + mock SerpApi
#   3 = name.com sandbox + Vercel deploy + live SerpApi
#   4 = name.com production + Vercel deploy + live SerpApi + custom domain DNS
P2B_LIVE_INTEGRATIONS=0

# name.com sandbox (used when P2B_LIVE_INTEGRATIONS=0, 1, or 3)
NAMECOM_SANDBOX_USER=yourusername-test
NAMECOM_SANDBOX_TOKEN=
NAMECOM_SANDBOX_URL=https://api.dev.name.com

# name.com production (used when P2B_LIVE_INTEGRATIONS=4)
NAMECOM_PRODUCTION_USER=yourusername
NAMECOM_PRODUCTION_TOKEN=
NAMECOM_PRODUCTION_URL=https://api.name.com

# Legacy single-set name.com vars (optional fallback for local dev)
# NAMECOM_API_USER=
# NAMECOM_API_TOKEN=
# NAMECOM_API_URL=https://api.dev.name.com

# SerpApi (used when P2B_LIVE_INTEGRATIONS=3 or 4)
SERPAPI_KEY=

# Vercel Deploy API (Launch brand — one static project per site)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
