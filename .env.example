# Meta Model API (site + domain brainstorm + logo via muse-image-1.0)
# Create at: https://dev.meta.ai/ -> API keys
MODEL_API_KEY=
# Chat model ID — must appear in GET https://api.meta.ai/v1/models for your key
# Default: muse-wonder-1.0 (use muse-spark-1.3 if listed on your key)
# META_MODEL=muse-wonder-1.0
# Reasoning depth for site + domain LLM calls (minimal | low | medium | high)
# META_REASONING_EFFORT=low

# Neon Postgres (injected by Vercel Marketplace when connected)
POSTGRES_URL=
# DATABASE_URL=

# Integration mode:
#   0 = name.com sandbox + Postgres-hosted site link + mock SerpApi
#   1 = name.com sandbox + Vercel deploy + mock SerpApi
#   2 = name.com sandbox + Vercel deploy + live SerpApi
#   3 = name.com production + Vercel deploy + live SerpApi + custom domain DNS
P2B_LIVE_INTEGRATIONS=0

# name.com sandbox (used when P2B_LIVE_INTEGRATIONS=0, 1, or 2)
NAMECOM_SANDBOX_USER=yourusername-test
NAMECOM_SANDBOX_TOKEN=
NAMECOM_SANDBOX_URL=https://api.dev.name.com

# name.com production (used when P2B_LIVE_INTEGRATIONS=3)
NAMECOM_PRODUCTION_USER=yourusername
NAMECOM_PRODUCTION_TOKEN=
NAMECOM_PRODUCTION_URL=https://api.name.com

# Legacy single-set name.com vars (optional fallback for local dev)
# NAMECOM_API_USER=
# NAMECOM_API_TOKEN=
# NAMECOM_API_URL=https://api.dev.name.com

# SerpApi (used when P2B_LIVE_INTEGRATIONS=2 or 3)
SERPAPI_KEY=

# Vercel Deploy API (Launch brand — one static project per site)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
